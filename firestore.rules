rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperadmin() {
      return isSignedIn() && myProfile().role == 'superadmin';
    }

    function isCoachOfClub(clubId) {
      return isSignedIn()
        && myProfile().role == 'coach'
        && myProfile().clubId == clubId;
    }

    function isAthleteInClub(clubId, athleteId) {
      return isSignedIn()
        && request.auth.uid == athleteId
        && myProfile().role == 'athlete'
        && myProfile().clubId == clubId
        && myProfile().blocked != true;
    }

    // Invitaciones: el entrenador crea una invitación con el correo del
    // futuro atleta y el club al que pertenece. El propio atleta, una vez
    // identificado con ese mismo correo (vía enlace mágico), puede LEER su
    // invitación para saber a qué club pertenece y crear su perfil.
    match /invites/{inviteId} {
      allow read: if isSignedIn() && request.auth.token.email == resource.data.email;
      allow create, update: if isSuperadmin() || (
        isSignedIn() && myProfile().role == 'coach' &&
        request.resource.data.clubId == myProfile().clubId &&
        request.resource.data.role == 'athlete'
      );
      allow delete: if isSuperadmin() || isCoachOfClub(resource.data.clubId);
    }

    // Perfil de cada usuario (atleta, entrenador o superadmin).
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isSuperadmin() ||
        (myProfile().role == 'coach' && resource.data.clubId == myProfile().clubId)
      );
      // El propio atleta puede crear (una sola vez) su perfil, pero SOLO
      // copiando exactamente el club y el rol que le fijó la invitación de
      // su entrenador — nunca puede inventarse un club o un rol distinto.
      allow create: if isSignedIn() && request.auth.uid == uid && (
        isSuperadmin() ||
        (
          request.resource.data.role == 'athlete' &&
          exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)) &&
          get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.email == request.auth.token.email &&
          request.resource.data.clubId == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.clubId
        ) ||
        (isSignedIn() && myProfile().role == 'coach' && request.resource.data.clubId == myProfile().clubId)
      );
      // Cambios posteriores (bloquear, cambiar de club, etc.) solo los hace
      // el entrenador de ese club o el superadmin — nunca el propio usuario.
      allow update, delete: if isSuperadmin() ||
        (isSignedIn() && myProfile().role == 'coach' && resource.data.clubId == myProfile().clubId);
    }

    // Clubes: el superadmin los crea/bloquea; cada entrenador solo lee el suyo.
    match /clubs/{clubId} {
      allow read: if isSuperadmin() || isCoachOfClub(clubId);
      allow write: if isSuperadmin();
    }

    // Datos de entrenamiento de cada atleta, organizados por club.
    match /clubs/{clubId}/athletes/{athleteId} {
      allow read: if isSuperadmin() || isCoachOfClub(clubId) || isAthleteInClub(clubId, athleteId);
      allow write: if isSuperadmin() || isCoachOfClub(clubId);
    }
    match /clubs/{clubId}/athletes/{athleteId}/progress/{docId} {
      allow read: if isSuperadmin() || isCoachOfClub(clubId) || isAthleteInClub(clubId, athleteId);
      allow write: if isSuperadmin() || isCoachOfClub(clubId) || isAthleteInClub(clubId, athleteId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
