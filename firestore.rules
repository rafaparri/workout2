rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // --- Permisos independientes por rol, en vez de un único campo "role"
    // en el perfil. Así, la misma persona puede tener a la vez un permiso
    // de entrenador y otro de atleta, sin que se pisen entre sí.
    function clubIsBlocked(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data.blocked == true;
    }
    // Sin mirar si está bloqueado — se usa solo para poder LEER la ficha
    // del club y así mostrar el aviso de bloqueo en vez de un error de
    // permisos genérico y confuso.
    function isCoachOfClub(clubId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/roleGrants/coach)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/roleGrants/coach).data.clubId == clubId;
    }
    // Esta sí exige que el club no esté bloqueado — es la que se usa para
    // todo lo demás (atletas, planes, progreso...).
    function hasCoachGrant(clubId) {
      return isCoachOfClub(clubId) && !clubIsBlocked(clubId);
    }
    function hasSuperadminGrant() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/roleGrants/superadmin);
    }
    function hasAthleteGrant(clubId, athleteUid) {
      return isSignedIn()
        && request.auth.uid == athleteUid
        && exists(/databases/$(database)/documents/users/$(athleteUid)/roleGrants/athlete)
        && get(/databases/$(database)/documents/users/$(athleteUid)/roleGrants/athlete).data.clubId == clubId
        && get(/databases/$(database)/documents/clubs/$(clubId)/athletes/$(athleteUid)).data.blocked != true
        && !clubIsBlocked(clubId);
    }

    // --- Identidad básica de cada persona (nombre, correo). Sin rol aquí.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || hasSuperadminGrant());
      allow create, update: if isSignedIn() && request.auth.uid == uid;
    }

    // --- Permisos por rol de cada persona (subcolección de users/{uid}).
    match /users/{uid}/roleGrants/{grantId} {
      allow read: if isSignedIn() && (request.auth.uid == uid || hasSuperadminGrant());
      // "superadmin" lo concede siempre el superadmin a mano. "coach" y
      // "athlete" se los puede conceder el propio usuario a sí mismo, pero
      // solo copiando el club exacto que diga una invitación válida — del
      // superadmin si es para entrenador, de su entrenador si es atleta —
      // nunca inventándose otro club ni otro rol.
      allow create: if hasSuperadminGrant() || (
        (grantId == 'athlete' || grantId == 'coach') && isSignedIn() && request.auth.uid == uid &&
        exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)) &&
        get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.email == request.auth.token.email &&
        get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.role == grantId &&
        request.resource.data.clubId == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.clubId
      );
      allow update, delete: if hasSuperadminGrant();
    }

    match /invites/{inviteId} {
      allow read: if isSignedIn() && request.auth.token.email == resource.data.email;
      allow create, update: if hasSuperadminGrant() || (
        isSignedIn() && hasCoachGrant(request.resource.data.clubId) && request.resource.data.role == 'athlete'
      );
      allow delete: if hasSuperadminGrant() || hasCoachGrant(resource.data.clubId);
    }

    match /clubs/{clubId} {
      allow read: if hasSuperadminGrant() || isCoachOfClub(clubId) || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/roleGrants/athlete) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/roleGrants/athlete).data.clubId == clubId
      );
      allow write: if hasSuperadminGrant();
    }

    // --- Ficha de cada atleta dentro de un club: nombre, correo, si está
    // bloqueado, si hay algo sin revisar. La lee/edita el entrenador del
    // club; el propio atleta solo la lee. El atleta la CREA él mismo la
    // primera vez, al autoregistrarse con una invitación válida.
    match /clubs/{clubId}/athletes/{athleteId} {
      allow read: if hasSuperadminGrant() || hasCoachGrant(clubId) || (isSignedIn() && request.auth.uid == athleteId);
      allow write: if hasSuperadminGrant() || hasCoachGrant(clubId);
      allow create: if isSignedIn() && request.auth.uid == athleteId &&
        exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)) &&
        get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.clubId == clubId;
    }

    match /clubs/{clubId}/athletes/{athleteId}/plans/{planId} {
      allow read: if hasSuperadminGrant() || hasCoachGrant(clubId) || hasAthleteGrant(clubId, athleteId);
      allow write: if hasSuperadminGrant() || hasCoachGrant(clubId);
    }
    match /clubs/{clubId}/athletes/{athleteId}/progress/{docId} {
      allow read: if hasSuperadminGrant() || hasCoachGrant(clubId) || hasAthleteGrant(clubId, athleteId);
      allow write: if hasSuperadminGrant() || hasCoachGrant(clubId) || hasAthleteGrant(clubId, athleteId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
